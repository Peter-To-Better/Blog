---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import Pagination from '../components/Pagination.astro';
import LogoSVG from '../components/LogoSVG.astro';
import Particles from '../components/Particles.astro';
import TechWords from '../components/TechWords.astro';
import { getExcerpt } from '../utils/helpers';

const POSTS_PER_PAGE = 9;

const allPosts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);
const posts = allPosts.slice(0, POSTS_PER_PAGE);
---

<BaseLayout>
  <noscript>
    <style>
      .load-row, .load-section-header { opacity: 1 !important; transform: none !important; }
    </style>
  </noscript>

  <!-- Hero: particle BG + logo left + 3D portrait right -->
  <section class="relative overflow-hidden border-b border-gray-100 dark:border-gray-800">
    <!-- Particle background canvas -->
    <Particles />

    <h1 class="sr-only">Peter To Better｜從前端、後端到 AI 開發的繁中技術筆記</h1>

    <div class="relative z-10 max-w-5xl mx-auto px-6 sm:px-8 py-16 sm:py-20 flex flex-col sm:flex-row items-center justify-between gap-12 sm:gap-8">

      <!-- Left: Logo + tagline -->
      <div class="flex flex-col items-center sm:items-start gap-0">
        <LogoSVG class="w-52 sm:w-64 text-gray-900 dark:text-white" animate />
        <p class="mt-5 text-xs tracking-[0.25em] uppercase text-gray-400 dark:text-gray-500 sm:text-left text-center">
          技術學習 &nbsp;·&nbsp; 成長筆記 &nbsp;·&nbsp; 與你一起變好
        </p>
        <a
          href="https://github.com/Peter-To-Better"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-2 text-xs text-gray-400 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-200 transition-colors duration-150 font-mono"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
          </svg>
          @Peter-To-Better
        </a>
      </div>

      <!-- Right: tech keyword cloud -->
      <div class="shrink-0">
        <TechWords class="w-56 h-56 sm:w-72 sm:h-72" />
      </div>

    </div>
  </section>

  <!-- Post list -->
  <div class="max-w-3xl mx-auto px-4 sm:px-6 pb-16">

    <div class="load-section-header flex items-center gap-4 py-5 mb-1">
      <span class="text-[10px] font-semibold tracking-[0.3em] uppercase text-gray-400 dark:text-gray-500 shrink-0">
        最新文章
      </span>
      <div class="flex-1 h-px bg-gray-100 dark:bg-gray-800"></div>
    </div>

    {posts.map((post, i) => (
      <PostRow
        index={i}
        title={post.data.title}
        pubDate={post.data.pubDate}
        category={post.data.category}
        tags={post.data.tags}
        description={post.data.description || getExcerpt(post.body)}
        slug={post.id.replace(/\.md$/, '')}
        body={post.body}
      />
    ))}

    <Pagination currentPage={1} totalPages={totalPages} />
  </div>
</BaseLayout>

<script>
  import gsap from 'gsap';

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.set('.load-section-header', { opacity: 0 });
    gsap.set('.load-row', { opacity: 0, y: 22 });

    gsap.to('.load-section-header', {
      opacity: 1, duration: 0.5, delay: 1.5, ease: 'power2.out',
    });
    gsap.to('.load-row', {
      opacity: 1, y: 0, duration: 0.45, stagger: 0.07, delay: 1.7, ease: 'power2.out',
    });
  }
</script>
