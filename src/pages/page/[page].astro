---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import Pagination from '../../components/Pagination.astro';
import { getExcerpt } from '../../utils/helpers';

export const getStaticPaths: GetStaticPaths = async () => {
  const postsPerPage = 9;
  const allPosts = (await getCollection('posts'))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  const totalPages = Math.ceil(allPosts.length / postsPerPage);

  return Array.from({ length: totalPages }, (_, i) => ({
    params: { page: String(i + 1) },
    props: {
      posts: allPosts.slice(i * postsPerPage, (i + 1) * postsPerPage),
      currentPage: i + 1,
      totalPages,
    },
  }));
};

const { posts, currentPage, totalPages } = Astro.props;
---

<BaseLayout title={`第 ${currentPage} 頁`}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10 pb-16">

    <div class="flex items-center gap-4 mb-8">
      <h1 class="text-[10px] font-semibold tracking-[0.3em] uppercase text-gray-400 dark:text-gray-500 shrink-0">
        所有文章
      </h1>
      <div class="flex-1 h-px bg-gray-100 dark:bg-gray-800"></div>
      <span class="text-xs text-gray-300 dark:text-gray-700 font-mono shrink-0">
        {currentPage} / {totalPages}
      </span>
    </div>

    {posts.map((post: any, i: number) => (
      <PostRow
        index={(currentPage - 1) * 9 + i}
        title={post.data.title}
        pubDate={post.data.pubDate}
        category={post.data.category}
        tags={post.data.tags}
        description={post.data.description || getExcerpt(post.body)}
        slug={post.id.replace(/\.md$/, '')}
        body={post.body}
      />
    ))}

    <Pagination currentPage={currentPage} totalPages={totalPages} />
  </div>
</BaseLayout>
