---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getSeriesKey } from '../../utils/helpers';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
};

const { post } = Astro.props;
const { Content, headings } = await render(post);

const allPosts = await getCollection('posts');
const relatedPosts = allPosts
  .filter((p) => !p.data.draft && p.id !== post.id)
  .map((p) => ({
    p,
    score: p.data.tags.filter((t) => post.data.tags.includes(t)).length,
  }))
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map(({ p }) => ({
    title: p.data.title,
    slug: p.id.replace(/\.md$/, ''),
    category: p.data.category,
    pubDate: p.data.pubDate,
    description: p.data.description,
    tags: p.data.tags,
  }));

const currentSlug = post.id.replace(/\.md$/, '');
const seriesKey = getSeriesKey(currentSlug);
let prevPost = null;
let nextPost = null;
if (seriesKey) {
  const series = allPosts
    .filter((p) => !p.data.draft && getSeriesKey(p.id.replace(/\.md$/, '')) === seriesKey)
    .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
  const idx = series.findIndex((p) => p.id === post.id);
  if (idx > 0) {
    const p = series[idx - 1];
    prevPost = { title: p.data.title, slug: p.id.replace(/\.md$/, '') };
  }
  if (idx > -1 && idx < series.length - 1) {
    const p = series[idx + 1];
    nextPost = { title: p.data.title, slug: p.id.replace(/\.md$/, '') };
  }
}
---

<PostLayout
  title={post.data.title}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  category={post.data.category}
  tags={post.data.tags}
  keywords={post.data.keywords}
  description={post.data.description}
  image={post.data.image}
  body={post.body}
  headings={headings}
  relatedPosts={relatedPosts}
  prevPost={prevPost}
  nextPost={nextPost}
>
  <Content />
</PostLayout>
