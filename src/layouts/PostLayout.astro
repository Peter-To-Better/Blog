---
import BaseLayout from './BaseLayout.astro';
import { formatDate, getReadingTime } from '../utils/helpers';

interface Props {
  title: string;
  pubDate: Date;
  category: string;
  tags: string[];
  keywords?: string;
  description?: string;
  image?: string;
  body: string;
}

const { title, pubDate, category, tags, keywords, description, image, body } = Astro.props;
const readingTime = getReadingTime(body);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description ?? '',
  author: {
    '@type': 'Person',
    name: 'Peter',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'peter-to-better',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/favicon.svg`,
    },
  },
  datePublished: pubDate.toISOString(),
  url: Astro.url.toString(),
  keywords: keywords ?? tags.join(', '),
  inLanguage: 'zh-TW',
  ...(image && { image: image.startsWith('http') ? image : `${siteUrl}${image}` }),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: siteUrl || '/' },
    { '@type': 'ListItem', position: 2, name: category, item: `${siteUrl}/categories/${category}` },
    { '@type': 'ListItem', position: 3, name: title, item: Astro.url.toString() },
  ],
};
---

<BaseLayout title={title} description={description} image={image} keywords={keywords}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-10">
    <!-- Header -->
    <header class="mb-10">
      <!-- Breadcrumb -->
      <nav aria-label="breadcrumb" class="flex items-center gap-1.5 text-xs text-gray-400 dark:text-gray-500 mb-5">
        <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">首頁</a>
        <span aria-hidden="true">/</span>
        <a href={`/categories/${category}`} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
          {category}
        </a>
        <span aria-hidden="true">/</span>
        <span class="text-gray-500 dark:text-gray-400 truncate max-w-[200px] sm:max-w-none">{title}</span>
      </nav>

      <div class="flex items-center gap-2 text-sm mb-4">
        <a
          href={`/categories/${category}`}
          class="px-2.5 py-1 bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-400 rounded-md font-medium hover:bg-blue-100 dark:hover:bg-blue-900 transition-colors"
        >
          {category}
        </a>
        <span class="text-gray-300 dark:text-gray-600">&middot;</span>
        <time datetime={pubDate.toISOString()} class="text-gray-500 dark:text-gray-400">
          {formatDate(pubDate)}
        </time>
        <span class="text-gray-300 dark:text-gray-600">&middot;</span>
        <span class="text-gray-500 dark:text-gray-400">{readingTime} min read</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white leading-tight mb-4">
        {title}
      </h1>

      <div class="flex flex-wrap gap-2">
        {tags.map((tag) => (
          <a
            href={`/tags/${tag}`}
            class="px-2.5 py-1 text-sm text-gray-500 dark:text-gray-400 bg-gray-50 dark:bg-gray-800 rounded-md hover:text-blue-600 dark:hover:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-950 transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>
    </header>

    <!-- Content -->
    <div class="prose prose-lg dark:prose-invert max-w-none">
      <slot />
    </div>

    <!-- Footer -->
    <footer class="mt-16 pt-8 border-t border-gray-100 dark:border-gray-800">
      <!-- Buy Me a Coffee -->
      <div class="text-center mb-8">
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">如果這篇文章對你有幫助</p>
        <a
          href="https://www.buymeacoffee.com/shoublog"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-amber-800 bg-amber-50 dark:text-amber-200 dark:bg-amber-900/30 rounded-full hover:bg-amber-100 dark:hover:bg-amber-900/50 transition-colors"
        >
          <span>&#9749;</span>
          Buy me a coffee
        </a>
      </div>

      <!-- Giscus Comments -->
      <div class="mt-10" id="comments">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6">留言討論</h2>
        <script
          src="https://giscus.app/client.js"
          data-repo="ShouShouRen/shoublog"
          data-repo-id=""
          data-category="General"
          data-category-id=""
          data-mapping="pathname"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="top"
          data-theme="preferred_color_scheme"
          data-lang="zh-TW"
          crossorigin="anonymous"
          async
        ></script>
      </div>
    </footer>
  </article>
</BaseLayout>

<style is:global>
  /* 讓 mermaid 圖跳出 prose 的 code block 樣式，置中、無底色 */
  pre.mermaid {
    background: transparent;
    padding: 0;
    margin: 1.5rem 0;
    text-align: center;
    overflow-x: auto;
  }
  /* 渲染完成前先隱藏原始文字，避免閃現一坨語法 */
  pre.mermaid:not([data-processed]) {
    visibility: hidden;
  }
</style>

<script>
  // 只有頁面真的有 mermaid 圖時才動態載入 mermaid（code-split，省流量）
  if (document.querySelector('pre.mermaid')) {
    const { default: mermaid } = await import('mermaid');
    const isDark = document.documentElement.classList.contains('dark');
    mermaid.initialize({
      startOnLoad: false,
      theme: isDark ? 'dark' : 'default',
      securityLevel: 'strict',
    });
    await mermaid.run({ querySelector: 'pre.mermaid' });
  }
</script>
