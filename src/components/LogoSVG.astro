<script>
  const animatedLogos = document.querySelectorAll<SVGElement>('.to-better-logo[data-animate]');

  if (animatedLogos.length > 0) {
    const { gsap } = await import('gsap');

    function initLogoAnimation(svg: SVGElement) {
      const icon      = svg.querySelector<SVGElement>('.logo-icon')!;
      const text      = svg.querySelector<SVGElement>('.logo-text')!;
      const underline = svg.querySelector<SVGElement>('.logo-underline')!;
      const tagline   = svg.querySelector<SVGElement>('.logo-tagline')!;

      gsap.set([text, underline, tagline], { opacity: 0 });

      const tl = gsap.timeline({ delay: 0.2 });
      tl
        // Icon: clip-path reveals from top downward (chevron first, arm sweep last)
        .fromTo(icon,
          { clipPath: 'inset(0% 0% 100% 0%)' },
          { clipPath: 'inset(0% 0% 0% 0%)', duration: 1.2, ease: 'power3.out' }
        )
        // Text slides in from left
        .fromTo(text,
          { opacity: 0, x: -20 },
          { opacity: 1, x: 0, duration: 0.9, ease: 'power3.out' },
          '-=0.4'
        )
        // Underline (two lines): grows from left
        .fromTo(underline,
          { opacity: 0, scaleX: 0, transformOrigin: 'left center' },
          { opacity: 1, scaleX: 1, duration: 0.85, ease: 'power2.out' },
          '-=0.3'
        )
        // Tagline fades in last
        .fromTo(tagline,
          { opacity: 0 },
          { opacity: 0.42, duration: 0.7, ease: 'power2.out' },
          '-=0.15'
        );

      // Icon: gentle float after reveal
      const floatTween = gsap.to(icon, {
        y: -5, duration: 2.8, ease: 'sine.inOut', yoyo: true, repeat: -1, delay: 1.5,
      });

      // Hover: tilt up-right with elastic return
      svg.addEventListener('mouseenter', () => {
        floatTween.pause();
        gsap.to(icon, { x: 6, y: -10, rotation: 6, duration: 0.28, ease: 'power2.out', overwrite: 'auto' });
      });
      svg.addEventListener('mouseleave', () => {
        gsap.to(icon, {
          x: 0, y: 0, rotation: 0, duration: 0.85, ease: 'elastic.out(1, 0.4)', overwrite: 'auto',
          onComplete: () => floatTween.restart(),
        });
      });
    }

    animatedLogos.forEach(svg => initLogoAnimation(svg));
  }
</script>
