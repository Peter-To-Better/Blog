---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string;
  type?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
}

const siteTitle = 'Peter To Better';
const siteTagline = '從前端、後端到 AI 開發的繁中技術筆記';
const siteDescription = '從前端、後端、AI 開發到 Docker/K8s 維運，把學會的都寫成繁體中文技術筆記，一個變好變強的部落格。';

const websiteSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Peter To Better',
  alternateName: ['peter-to-better', 'Peter-To-Better', 'PeterToBetter'],
  url: Astro.site?.toString(),
});

const organizationSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Peter To Better',
  alternateName: ['peter-to-better', 'PeterToBetter'],
  url: Astro.site?.toString(),
  logo: new URL('/favicon.svg', Astro.site).toString(),
  sameAs: [
    'https://x.com/PeterToBetter',
    'https://www.instagram.com/peter.to.better/',
    'https://github.com/Peter-To-Better',
  ],
});

const {
  title,
  description = siteDescription,
  image = '/og-default.png',
  keywords,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${siteTitle}` : `${siteTitle}｜${siteTagline}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />

  <!-- Primary Meta Tags -->
  <title>{fullTitle}</title>
  <meta name="title" content={fullTitle} />
  <meta name="description" content={description} />
  <meta name="author" content="Peter" />
  {keywords && <meta name="keywords" content={keywords} />}
  <link rel="canonical" href={canonicalURL} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="alternate" type="application/rss+xml" title={siteTitle} href={new URL('/rss.xml', Astro.site)} />
  {Astro.url.pathname === '/' && <script type="application/ld+json" set:html={websiteSchema} />}
  {Astro.url.pathname === '/' && <script type="application/ld+json" set:html={organizationSchema} />}

  <!-- Open Graph -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta property="og:locale" content="zh_TW" />
  <meta property="og:site_name" content={siteTitle} />
  {type === 'article' && publishedTime && (
    <meta property="article:published_time" content={publishedTime.toISOString()} />
  )}
  {type === 'article' && modifiedTime && (
    <meta property="article:modified_time" content={modifiedTime.toISOString()} />
  )}
  {type === 'article' && (
    <meta property="article:author" content="Peter" />
  )}

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonicalURL} />
  <meta property="twitter:title" content={fullTitle} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={new URL(image, Astro.site)} />

  <!-- Google Analytics -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-959LSCY0GX"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-959LSCY0GX');
  </script>

  <!-- Dark mode: prevent flash -->
  <script is:inline>
    const theme = localStorage.getItem('theme');
    if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    }
  </script>
</head>
