        </g>
      </svg>

      <div class="hidden sm:block leading-tight">
        <div class="text-[13px] font-extrabold tracking-tight text-gray-900 dark:text-white">
          peter-to-better
        </div>
        <div class="text-[9px] font-semibold tracking-[0.25em] uppercase text-gray-400 dark:text-gray-500 mt-0.5">
          growing together
        </div>
      </div>
    </a>

    <!-- Nav -->
    <div class="flex items-center gap-0.5">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            'relative px-3 py-2 text-sm transition-colors duration-150 font-medium',
            currentPath === href || (href !== '/' && currentPath.startsWith(href))
              ? 'text-gray-900 dark:text-white font-semibold after:absolute after:bottom-1 after:left-3 after:right-3 after:h-px after:bg-gray-900 dark:after:bg-white'
              : 'text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100',
          ]}
        >
          {label}
        </a>
      ))}
      <a
        href="https://github.com/Peter-To-Better"
        target="_blank"
        rel="noopener noreferrer"
        class="px-3 py-2 text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 transition-colors duration-150"
      >
        GitHub
      </a>
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  import gsap from 'gsap';

  const headerLogo = document.querySelector('header a[aria-label]');
  const logoEl = document.querySelector<SVGElement>('header .hd-logo');

  if (headerLogo && logoEl) {
    // Page load: icon grows from bottom upward (clip-path reveal)
    gsap.fromTo(logoEl,
      { clipPath: 'inset(100% 0% 0% 0%)' },
      { clipPath: 'inset(0% 0% 0% 0%)', duration: 0.9, ease: 'power3.out', delay: 0.1 }
    );

    // After reveal: gentle continuous upward float like a wandering hero
    const floatTween = gsap.to(logoEl, {
      y: -4, duration: 2.2, ease: 'sine.inOut', yoyo: true, repeat: -1, delay: 1.1,
    });

    headerLogo.addEventListener('mouseenter', () => {
      floatTween.pause();
      gsap.to(logoEl, { x: 3, y: -6, rotation: 5, duration: 0.22, ease: 'power2.out', overwrite: 'auto' });
    });
    headerLogo.addEventListener('mouseleave', () => {
      gsap.to(logoEl, {
        x: 0, y: 0, rotation: 0, duration: 0.7, ease: 'elastic.out(1, 0.4)', overwrite: 'auto',
        onComplete: () => floatTween.restart(),
      });
    });
  }
</script>
