---
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { href: '/', label: '首頁' },
  { href: '/archives', label: '歸檔' },
  { href: '/tags', label: '標籤' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/90 dark:bg-[#0c0c0c]/90 backdrop-blur-md border-b border-gray-200 dark:border-gray-800">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">

    <!-- Logo: compact icon (traced from PNG) + text -->
    <a href="/" class="flex items-center gap-2.5 group" aria-label="To_Better 首頁">
      <!-- Icon: potrace-traced paths 1-2 (hand/arm + chevron), cropped viewBox -->
      <svg
        viewBox="110 0 380 295"
        class="hd-logo h-8 w-auto text-gray-900 dark:text-white shrink-0"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <g transform="translate(-410.000000,626.045368) scale(0.100000,-0.100000)" fill="currentColor" stroke="none">
