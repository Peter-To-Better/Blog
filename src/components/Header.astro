---
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { href: '/', label: '首頁' },
  { href: '/archives', label: '歸檔' },
  { href: '/tags', label: '標籤' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/90 dark:bg-[#0c0c0c]/90 backdrop-blur-md border-b border-gray-200 dark:border-gray-800">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">

    <!-- Logo: compact arrow icon + text -->
    <a href="/" class="flex items-center gap-2.5 group" aria-label="To_Better 首頁">
      <!-- Compact arrow icon (matches LogoSVG style, currentColor) -->
      <svg
        viewBox="0 0 44 40"
        class="h-8 w-auto text-gray-900 dark:text-white shrink-0"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          class="hd-hand"
          d="M 3,34 C 8,28 14,24 22,26 C 27,27 30,22 33,18"
          stroke="currentColor" stroke-width="2.8" stroke-linecap="round"
        />
        <path
          class="hd-arrow"
          d="M 10,30 L 38,6"
          stroke="currentColor" stroke-width="2.8" stroke-linecap="round"
        />
        <path
          class="hd-arrow"
          d="M 28,2 L 40,6 L 36,18"
          stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"
        />
      </svg>

      <div class="hidden sm:block leading-tight">
        <div class="text-[13px] font-extrabold tracking-tight text-gray-900 dark:text-white">
          peter-to-better
        </div>
        <div class="text-[9px] font-semibold tracking-[0.25em] uppercase text-gray-400 dark:text-gray-500 mt-0.5">
          growing together
        </div>
      </div>
    </a>

    <!-- Nav -->
    <div class="flex items-center gap-0.5">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            'relative px-3 py-2 text-sm transition-colors duration-150 font-medium',
            currentPath === href || (href !== '/' && currentPath.startsWith(href))
              ? 'text-gray-900 dark:text-white font-semibold after:absolute after:bottom-1 after:left-3 after:right-3 after:h-px after:bg-gray-900 dark:after:bg-white'
              : 'text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100',
          ]}
        >
          {label}
        </a>
      ))}
      <a
        href="https://github.com/ShouShouRen"
        target="_blank"
        rel="noopener noreferrer"
        class="px-3 py-2 text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 transition-colors duration-150"
      >
        GitHub
      </a>
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  import gsap from 'gsap';

  const headerLogo = document.querySelector('header a[aria-label]');
  const arrowEls = document.querySelectorAll('header .hd-arrow');

  if (headerLogo && arrowEls.length) {
    headerLogo.addEventListener('mouseenter', () => {
      gsap.to(arrowEls, { x: 2, y: -2, duration: 0.2, ease: 'power2.out' });
    });
    headerLogo.addEventListener('mouseleave', () => {
      gsap.to(arrowEls, { x: 0, y: 0, duration: 0.4, ease: 'elastic.out(1, 0.5)' });
    });
  }
</script>
