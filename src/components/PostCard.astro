---
import { formatDate, getReadingTime } from '../utils/helpers';

interface Props {
  title: string;
  pubDate: Date;
  category: string;
  tags: string[];
  description: string;
  slug: string;
  body: string;
}

const { title, pubDate, category, tags, description, slug, body } = Astro.props;
const readingTime = getReadingTime(body);
---

<article class="group border border-gray-200 dark:border-gray-800 hover:border-gray-400 dark:hover:border-gray-600 rounded-xl transition-all duration-200 hover:shadow-sm bg-white dark:bg-transparent overflow-hidden">
  <a href={`/posts/${slug}/`} class="block p-6">
    <!-- Category & Meta -->
    <div class="flex items-center gap-2 text-[11px] mb-3">
      <span class="font-semibold tracking-widest uppercase text-gray-400 dark:text-gray-500">
        {category}
      </span>
      <span class="text-gray-200 dark:text-gray-700">/</span>
      <time datetime={pubDate.toISOString()} class="text-gray-400 dark:text-gray-500">
        {formatDate(pubDate)}
      </time>
      <span class="text-gray-200 dark:text-gray-700">/</span>
      <span class="text-gray-400 dark:text-gray-500">{readingTime} min</span>
    </div>

    <!-- Title -->
    <h2 class="text-base font-bold text-gray-900 dark:text-gray-100 mb-2 group-hover:text-gray-500 dark:group-hover:text-gray-400 transition-colors line-clamp-2 leading-snug">
      {title}
    </h2>

    <!-- Description -->
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-4 line-clamp-2 leading-relaxed">
      {description}
    </p>

    <!-- Tags -->
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="text-[11px] text-gray-400 dark:text-gray-500">
          #{tag}
        </span>
      ))}
    </div>
  </a>
</article>
